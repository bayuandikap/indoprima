# ============================================================
# PT Multisari Indoprima — AI Engine v2.0
# Stack 100% Gratis: Ollama + HuggingFace + ChromaDB
# ============================================================

# Ollama Configuration (LLM Engine — lokal, gratis)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding Configuration (HuggingFace — lokal, gratis)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB Configuration (lokal, persistent)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# App Configuration
APP_TITLE=AI Engine API
APP_VERSION=2.0.0
DEBUG=False
